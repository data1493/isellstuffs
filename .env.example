# Stripe test secret only (sk_test_ / rk_test_). Never commit the value.
# Missing = local mock checkout. Live keys (sk_live_) are rejected.
STRIPE_SECRET_KEY=
# Optional. Hosted Checkout works without it. Stripe.js only if set (pk_test_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Canonical origin in production (https://isellstuffs.com). Local fallback is the dev host.
NEXT_PUBLIC_SITE_URL=

# Agent Row store. Unset = cookie default (one walker / one browser).
# Local durable file (already gitignored under /.data/):
# DATABASE_URL=sqlite:.data/agent-row.db
# In-memory SQL for tests:
# DATABASE_URL=sqlite::memory:
# Postgres (do not commit the real URL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=
