# Provision Upstash Redis on the Vercel project (Marketplace), then these
# are injected for production, preview, and development:
#   vercel integration add upstash
# The same names work for an older KV connection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to 1 to run the live crowd, same switch as `node script/serve.mjs`.
ROW_CROWD=
